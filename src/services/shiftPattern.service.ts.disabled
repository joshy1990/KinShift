import firestore from '@react-native-firebase/firestore';
import { Shift, ShiftType, PatternRule } from '@/types';
import { COLLECTIONS } from '@/config/firebase.config';
import { shiftService } from './shift.service';
import { addDays, addWeeks, startOfDay, endOfDay, isBefore, isAfter, format } from 'date-fns';

/**
 * Pattern Templates for common shift schedules
 */
export const PATTERN_TEMPLATES = {
  '4on4off': {
    name: '4 On / 4 Off',
    description: 'Work 4 days, rest 4 days',
    workDays: 4,
    restDays: 4,
    type: 'rotation' as const,
  },
  '5on2off': {
    name: '5 Days / Week',
    description: 'Monday to Friday',
    type: 'fixed_weekly' as const,
    weeklySchedule: {
      monday: true,
      tuesday: true,
      wednesday: true,
      thursday: true,
      friday: true,
      saturday: false,
      sunday: false,
    },
  },
  '2on2off': {
    name: '2 On / 2 Off',
    description: 'Work 2 days, rest 2 days',
    workDays: 2,
    restDays: 2,
    type: 'rotation' as const,
  },
  '3on3off': {
    name: '3 On / 3 Off',
    description: 'Work 3 days, rest 3 days',
    workDays: 3,
    restDays: 3,
    type: 'rotation' as const,
  },
  '2on3off': {
    name: '2 On / 3 Off (Firefighter)',
    description: 'Work 2 days, rest 3 days',
    workDays: 2,
    restDays: 3,
    type: 'rotation' as const,
  },
  '7on7off': {
    name: '7 On / 7 Off (Week On/Off)',
    description: 'Work 1 week, rest 1 week',
    workDays: 7,
    restDays: 7,
    type: 'rotation' as const,
  },
  '4on2off': {
    name: '4 On / 2 Off',
    description: 'Work 4 days, rest 2 days',
    workDays: 4,
    restDays: 2,
    type: 'rotation' as const,
  },
  weekends: {
    name: 'Weekends Only',
    description: 'Saturday and Sunday',
    type: 'fixed_weekly' as const,
    weeklySchedule: {
      monday: false,
      tuesday: false,
      wednesday: false,
      thursday: false,
      friday: false,
      saturday: true,
      sunday: true,
    },
  },
};

export type PatternTemplateKey = keyof typeof PATTERN_TEMPLATES;

interface GeneratePatternOptions {
  patternKey: PatternTemplateKey | 'custom';
  startDate: Date;
  shiftStartTime: string; // HH:mm format (e.g., "07:00")
  shiftEndTime: string; // HH:mm format (e.g., "19:00")
  title: string;
  householdId: string;
  ownerId: string;
  shiftType: ShiftType;
  notes?: string;
  customPattern?: PatternRule; // For custom patterns
  durationMonths?: number; // How many months to generate (default 6)
}

interface BatchShiftResult {
  success: boolean;
  shiftsCreated: number;
  errors: string[];
}

class ShiftPatternService {
  /**
   * Generate shifts from a pattern template
   */
  async generateShiftsFromPattern(
    options: GeneratePatternOptions,
    creatorName?: string
  ): Promise<BatchShiftResult> {
    const {
      patternKey,
      startDate,
      shiftStartTime,
      shiftEndTime,
      title,
      householdId,
      ownerId,
      shiftType,
      notes,
      customPattern,
      durationMonths = 6,
    } = options;

    try {
      // Generate shift dates based on pattern
      const shiftDates = this.calculateShiftDates(
        patternKey,
        startDate,
        durationMonths,
        customPattern
      );

      // Create shifts in batches to avoid overwhelming Firestore
      const batchSize = 50;
      let shiftsCreated = 0;
      const errors: string[] = [];

      for (let i = 0; i < shiftDates.length; i += batchSize) {
        const batchDates = shiftDates.slice(i, i + batchSize);
        
        try {
          await this.createShiftBatch(
            batchDates,
            {
              title,
              householdId,
              ownerId,
              shiftType,
              notes,
              shiftStartTime,
              shiftEndTime,
            },
            creatorName
          );
          shiftsCreated += batchDates.length;
        } catch (error) {
          const errorMsg = `Batch ${Math.floor(i / batchSize) + 1} failed: ${error}`;
          errors.push(errorMsg);
          console.error(errorMsg);
        }
      }

      return {
        success: errors.length === 0,
        shiftsCreated,
        errors,
      };
    } catch (error) {
      console.error('Failed to generate shifts from pattern:', error);
      throw new Error('Failed to generate shift pattern');
    }
  }

  /**
   * Calculate shift dates based on pattern type
   */
  private calculateShiftDates(
    patternKey: PatternTemplateKey | 'custom',
    startDate: Date,
    durationMonths: number,
    customPattern?: PatternRule
  ): Date[] {
    const dates: Date[] = [];
    const endDate = addDays(addWeeks(startDate, durationMonths * 4), 7); // ~6 months + buffer

    if (patternKey === 'custom' && customPattern) {
      return this.calculateCustomPatternDates(customPattern, startDate, endDate);
    }

    const template = PATTERN_TEMPLATES[patternKey as PatternTemplateKey];
    if (!template) {
      throw new Error(`Invalid pattern template: ${patternKey}`);
    }

    if (template.type === 'rotation') {
      // Rotation pattern (e.g., 4 on, 4 off)
      return this.calculateRotationDates(
        startDate,
        endDate,
        template.workDays!,
        template.restDays!
      );
    } else if (template.type === 'fixed_weekly') {
      // Fixed weekly pattern (e.g., Mon-Fri)
      return this.calculateWeeklyDates(
        startDate,
        endDate,
        template.weeklySchedule!
      );
    }

    return dates;
  }

  /**
   * Calculate rotation pattern dates (e.g., 4 on, 4 off)
   */
  private calculateRotationDates(
    startDate: Date,
    endDate: Date,
    workDays: number,
    restDays: number
  ): Date[] {
    const dates: Date[] = [];
    let currentDate = startOfDay(startDate);
    const cycleLength = workDays + restDays;
    let cycleDay = 0;

    while (isBefore(currentDate, endDate)) {
      // If we're in a work day phase of the cycle
      if (cycleDay < workDays) {
        dates.push(new Date(currentDate));
      }

      currentDate = addDays(currentDate, 1);
      cycleDay = (cycleDay + 1) % cycleLength;
    }

    return dates;
  }

  /**
   * Calculate fixed weekly pattern dates (e.g., Mon-Fri)
   */
  private calculateWeeklyDates(
    startDate: Date,
    endDate: Date,
    weeklySchedule: Record<string, boolean>
  ): Date[] {
    const dates: Date[] = [];
    let currentDate = startOfDay(startDate);

    // Map day names to JS day numbers (0 = Sunday, 6 = Saturday)
    const dayMap: Record<string, number> = {
      sunday: 0,
      monday: 1,
      tuesday: 2,
      wednesday: 3,
      thursday: 4,
      friday: 5,
      saturday: 6,
    };

    while (isBefore(currentDate, endDate)) {
      const dayOfWeek = currentDate.getDay();
      
      // Check if this day is a work day
      for (const [dayName, isWorkDay] of Object.entries(weeklySchedule)) {
        if (isWorkDay && dayMap[dayName] === dayOfWeek) {
          dates.push(new Date(currentDate));
          break;
        }
      }

      currentDate = addDays(currentDate, 1);
    }

    return dates;
  }

  /**
   * Calculate custom pattern dates
   */
  private calculateCustomPatternDates(
    pattern: PatternRule,
    startDate: Date,
    endDate: Date
  ): Date[] {
    if (pattern.type === 'rotation' && pattern.workDays && pattern.restDays) {
      return this.calculateRotationDates(
        startDate,
        endDate,
        pattern.workDays,
        pattern.restDays
      );
    } else if (pattern.type === 'fixed_weekly' && pattern.weeklySchedule) {
      return this.calculateWeeklyDates(startDate, endDate, pattern.weeklySchedule);
    }
    return [];
  }

  /**
   * Create a batch of shifts
   */
  private async createShiftBatch(
    dates: Date[],
    shiftData: {
      title: string;
      householdId: string;
      ownerId: string;
      shiftType: ShiftType;
      notes?: string;
      shiftStartTime: string; // HH:mm
      shiftEndTime: string; // HH:mm
    },
    creatorName?: string
  ): Promise<void> {
    const batch = firestore().batch();

    dates.forEach((date) => {
      // Parse time strings and create Date objects
      const [startHour, startMinute] = shiftData.shiftStartTime.split(':').map(Number);
      const [endHour, endMinute] = shiftData.shiftEndTime.split(':').map(Number);

      const startTime = new Date(date);
      startTime.setHours(startHour, startMinute, 0, 0);

      const endTime = new Date(date);
      endTime.setHours(endHour, endMinute, 0, 0);

      // Handle overnight shifts (end time is next day)
      if (endTime <= startTime) {
        endTime.setDate(endTime.getDate() + 1);
      }

      const shift: Omit<Shift, 'id'> = {
        title: shiftData.title,
        householdId: shiftData.householdId,
        ownerId: shiftData.ownerId,
        startTime,
        endTime,
        colorTag: this.getColorForShiftType(shiftData.shiftType),
        shiftType: shiftData.shiftType,
        notes: shiftData.notes || '',
        createdAt: new Date(),
        updatedAt: new Date(),
        lastEditedBy: shiftData.ownerId,
      };

      const docRef = firestore().collection(COLLECTIONS.SHIFTS).doc();
      batch.set(docRef, shift);
    });

    await batch.commit();
  }

  /**
   * Get color for shift type
   */
  private getColorForShiftType(shiftType: ShiftType): string {
    const SHIFT_TYPE_COLORS: Record<ShiftType, string> = {
      days: '#3498db',
      nights: '#2c3e50',
      afternoons: '#e67e22',
      morning: '#f39c12',
      evening: '#8e44ad',
      custom: '#95a5a6',
    };
    return SHIFT_TYPE_COLORS[shiftType] || '#3498db';
  }

  /**
   * Preview pattern (for UI display before creation)
   */
  previewPattern(
    patternKey: PatternTemplateKey | 'custom',
    startDate: Date,
    previewDays: number = 30,
    customPattern?: PatternRule
  ): Date[] {
    const endDate = addDays(startDate, previewDays);
    return this.calculateShiftDates(patternKey, startDate, 1, customPattern).filter(
      (date) => isBefore(date, endDate)
    );
  }

  /**
   * Validate pattern configuration
   */
  validatePattern(
    patternKey: PatternTemplateKey | 'custom',
    customPattern?: PatternRule
  ): { valid: boolean; error?: string } {
    if (patternKey === 'custom') {
      if (!customPattern) {
        return { valid: false, error: 'Custom pattern is required' };
      }

      if (customPattern.type === 'rotation') {
        if (!customPattern.workDays || customPattern.workDays < 1) {
          return { valid: false, error: 'Work days must be at least 1' };
        }
        if (!customPattern.restDays || customPattern.restDays < 0) {
          return { valid: false, error: 'Rest days cannot be negative' };
        }
      } else if (customPattern.type === 'fixed_weekly') {
        if (!customPattern.weeklySchedule) {
          return { valid: false, error: 'Weekly schedule is required' };
        }
        const hasAnyWorkDay = Object.values(customPattern.weeklySchedule).some(
          (day) => day === true
        );
        if (!hasAnyWorkDay) {
          return { valid: false, error: 'At least one work day must be selected' };
        }
      }
    }

    return { valid: true };
  }

  /**
   * Get pattern info for display
   */
  getPatternInfo(patternKey: PatternTemplateKey): {
    name: string;
    description: string;
  } | null {
    const template = PATTERN_TEMPLATES[patternKey];
    if (!template) return null;

    return {
      name: template.name,
      description: template.description,
    };
  }

  /**
   * Calculate total shifts that will be created
   */
  calculateShiftCount(
    patternKey: PatternTemplateKey | 'custom',
    startDate: Date,
    durationMonths: number = 6,
    customPattern?: PatternRule
  ): number {
    try {
      const dates = this.calculateShiftDates(
        patternKey,
        startDate,
        durationMonths,
        customPattern
      );
      return dates.length;
    } catch {
      return 0;
    }
  }
}

export const shiftPatternService = new ShiftPatternService();
