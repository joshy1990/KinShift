{
  "expo": {
    "name": "LinkShift",
    "slug": "linkshift",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F0F23"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linkshift.app",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "LinkShift uses notifications to inform you about shift updates, changes, and schedule conflicts in your households.",
        "NSLocationWhenInUseUsageDescription": "Your location is not used by LinkShift but is required by some system features.",
        "UIBackgroundModes": ["remote-notification"],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "backgroundColor": "#0F0F23",
      "package": "com.linkshift.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F0F23"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "519ab785-c013-4ecb-b983-2354ae498ec4"
      }
    }
  }
}
