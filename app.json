{
  "expo": {
    "name": "LinkShift",
    "slug": "linkshift",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F0F23"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linkshift.app"
    },
    "android": {
      "backgroundColor": "#0F0F23",
      "package": "com.linkshift.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F0F23"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "519ab785-c013-4ecb-b983-2354ae498ec4"
      }
    }
  }
}
