# ============================================
# KinShift Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NEVER commit .env.local to source control!
# For EAS builds, set these via: eas secret:create
# ============================================

# --- Expo / EAS ---
EXPO_OWNER=kinshift
EAS_PROJECT_ID=your-eas-project-id-here

# --- Firebase (used for google-services.json generation on web only) ---
# Native Android/iOS use google-services.json and GoogleService-Info.plist directly
# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# FIREBASE_APP_ID=your-firebase-app-id

# --- RevenueCat (Subscriptions) ---
REVENUECAT_API_KEY=your-revenuecat-public-api-key

# --- Sentry (Error Monitoring) ---
# SENTRY_DSN=https://your_key@your_org.ingest.sentry.io/your_project_id
# SENTRY_DEBUG=false

# --- AdMob (Ads - currently disabled) ---
# ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# ADMOB_BANNER_PORTRAIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# ADMOB_BANNER_LANDSCAPE_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# --- Contact ---
SUPPORT_EMAIL=support@offeryn.co.uk
