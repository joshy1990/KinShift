rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the document owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Get the household document
    function getHousehold(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }
    
    // Check if user is in the members array (members includes admins)
    function isHouseholdMember(householdId) {
      let household = getHousehold(householdId);
      return request.auth.uid in household.members;
    }
    
    // Check if user is a household admin
    function isHouseholdAdmin(householdId) {
      let household = getHousehold(householdId);
      return request.auth.uid in household.admins;
    }

    // Validate a string field: must be a string with length in bounds
    function isValidString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }
    
    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for household member lists)
      allow read: if isAuthenticated();
      // Only the owner can write their own profile
      allow write: if isOwner(userId);
    }
    
    // ========================================
    // HOUSEHOLDS COLLECTION
    // ========================================
    match /households/{householdId} {
      // Members can read their own household document directly
      allow get: if isAuthenticated() && isHouseholdMember(householdId);
      
      // List: only queries scoped to user's own membership.
      // Requires client query: where('members', 'array-contains', uid).
      // Join-code lookup MUST go through Cloud Function (see functions/).
      allow list: if isAuthenticated()
        && request.auth.uid in resource.data.members;
      
      // Any authenticated user can create a household
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['name', 'members', 'admins', 'creatorId'])
        && request.resource.data.creatorId == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins
        && isValidString(request.resource.data.name, 1, 100);
      
      // Only existing members can update; self-join bypass removed.
      // Joining via code MUST go through Cloud Function.
      allow update: if isAuthenticated() && isHouseholdMember(householdId);
      
      // Only admins can delete
      allow delete: if isHouseholdAdmin(householdId);
      
      // Subcollections under households
      match /settings/{settingsDoc} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdAdmin(householdId);
      }
      
      match /auditLog/{auditDoc} {
        allow read: if isHouseholdMember(householdId);
        // Only members can write household audit entries
        allow create: if isAuthenticated() && isHouseholdMember(householdId);
        allow update, delete: if false;
      }
    }
    
    // ========================================
    // SHIFTS COLLECTION
    // ========================================
    match /shifts/{shiftId} {
      // Read: owner for personal shifts, household members for household shifts
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.householdId != null && resource.data.householdId != '' && isHouseholdMember(resource.data.householdId))
      );
      
      // Create: user must be the owner; validate required fields
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'shiftType', 'startTime'])
        && isValidString(request.resource.data.shiftType, 1, 50);
      
      // Update: only the shift owner can edit; ownerId cannot be changed
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      
      // Delete: only the shift owner can delete
      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }
    
    // ========================================
    // DAY NOTES COLLECTION
    // ========================================
    match /dayNotes/{dayNoteId} {
      // Read: author for personal, household members for household notes
      allow read: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.householdId != null && resource.data.householdId != '' && isHouseholdMember(resource.data.householdId))
      );
      
      // Create: must be the author; validate content length
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 2000);
      
      // Update: author or household admin only; authorId cannot be changed
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdAdmin(resource.data.householdId))
      ) && request.resource.data.authorId == resource.data.authorId
        && isValidString(request.resource.data.content, 1, 2000);
      
      // Delete: author or household admin
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdAdmin(resource.data.householdId))
      );
    }
    
    // ========================================
    // MESSAGES COLLECTIONS
    // ========================================
    match /shiftMessages/{messageId} {
      // Read: author or household members only
      allow read: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.householdId != null && resource.data.householdId != '' && isHouseholdMember(resource.data.householdId))
      );
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 2000);
      // Messages are immutable — no updates allowed
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }
    
    match /dayMessages/{messageId} {
      // Read: author or household members only
      allow read: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.householdId != null && resource.data.householdId != '' && isHouseholdMember(resource.data.householdId))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 2000);
      // Messages are immutable — no updates allowed
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }
    
    // ========================================
    // INVITATIONS COLLECTION
    // ========================================
    match /invitations/{invitationId} {
      // Read: creator, invited user (by email), or household members only.
      // Global invite-code lookup MUST go through Cloud Function.
      allow read: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        resource.data.invitedEmail == request.auth.token.email ||
        (resource.data.householdId != null && isHouseholdMember(resource.data.householdId))
      );
      
      // Create: only household members (service layer additionally enforces admin check)
      allow create: if isAuthenticated() &&
        request.resource.data.householdId != null &&
        request.resource.data.invitedBy == request.auth.uid &&
        isHouseholdMember(request.resource.data.householdId);
      
      // Update: creator (cancel) or the invited user (accept/decline)
      allow update: if isAuthenticated() && (
        resource.data.invitedBy == request.auth.uid ||
        // Accept: user must be setting themselves as acceptedBy
        request.resource.data.acceptedBy == request.auth.uid
      );
      
      // Delete: only the invitation creator (service layer enforces admin check)
      allow delete: if isAuthenticated() && resource.data.invitedBy == request.auth.uid;
    }
    
    // ========================================
    // NOTIFICATIONS COLLECTION
    // ========================================
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Create: sender must identify themselves; validates required fields.
      // TODO: Migrate push delivery to Cloud Functions for server-side trust.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['userId', 'type', 'title', 'body'])
        && isValidString(request.resource.data.title, 1, 200)
        && isValidString(request.resource.data.body, 1, 1000);
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // CUSTOM PATTERNS COLLECTION
    // ========================================
    match /customPatterns/{patternId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // AUDIT LOGS COLLECTION
    // Scoped to own userId. Cross-user TTL cleanup moved to Cloud Function.
    // ========================================
    match /auditLogs/{logId} {
      // Users can only read their own audit logs
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Create: userId must match the authenticated user
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // No client-side updates
      allow update: if false;
      // Users can only delete their own (scoped TTL cleanup)
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // SECURITY EVENTS COLLECTION
    // Scoped to own userId. Cross-user TTL cleanup moved to Cloud Function.
    // ========================================
    match /securityEvents/{eventId} {
      // Users can only read their own security events
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Create: userId must match the authenticated user
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // No client-side updates
      allow update: if false;
      // Users can only delete their own (scoped TTL cleanup)
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // SUBSCRIPTIONS COLLECTION
    // Read + create (free tier init) on client. Tier changes blocked —
    // must come from RevenueCat webhook via Cloud Function / Admin SDK.
    // ========================================
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Client can only create the initial free-tier subscription
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.tier == 'free';
      
      // Client can update non-tier fields (e.g. status timestamps).
      // The tier field is immutable from the client — tier upgrades/downgrades
      // MUST come from a trusted server (Cloud Function / Admin SDK).
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.tier == resource.data.tier;
      
      // No client-side deletion
      allow delete: if false;
    }
    
    // ========================================
    // CATCH-ALL: Deny everything else
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
