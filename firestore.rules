rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the document owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Get the household document
    function getHousehold(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }
    
    // Check if user is in the members array (members includes admins)
    function isHouseholdMember(householdId) {
      let household = getHousehold(householdId);
      return request.auth.uid in household.members;
    }
    
    // Check if user is a household admin
    function isHouseholdAdmin(householdId) {
      let household = getHousehold(householdId);
      return request.auth.uid in household.admins;
    }
    
    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // ========================================
    // HOUSEHOLDS COLLECTION
    // ========================================
    match /households/{householdId} {
      // Members can read their own household
      allow read: if isAuthenticated() && isHouseholdMember(householdId);
      
      // Any authenticated user can create a household
      allow create: if isAuthenticated();
      
      // Members can update (needed for joining, leaving, role changes)
      // Admins can delete
      allow update: if isAuthenticated() && (
        isHouseholdMember(householdId) ||
        // Allow joining: user is adding themselves to members via arrayUnion
        request.auth.uid in request.resource.data.members
      );
      allow delete: if isHouseholdAdmin(householdId);
      
      // Subcollections under households
      match /settings/{settingsDoc} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdAdmin(householdId);
      }
      
      match /auditLog/{auditDoc} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isAuthenticated();
      }
    }
    
    // ========================================
    // SHIFTS COLLECTION
    // ========================================
    match /shifts/{shiftId} {
      // Read: owner for personal shifts, household members for household shifts
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.householdId != null && resource.data.householdId != '' && isHouseholdMember(resource.data.householdId))
      );
      
      // Create: user must be the owner
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == request.auth.uid;
      
      // Update: owner can always edit; household members can edit if allowed
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdMember(resource.data.householdId))
      );
      
      // Delete: owner or household admin
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdAdmin(resource.data.householdId))
      );
    }
    
    // ========================================
    // DAY NOTES COLLECTION
    // ========================================
    match /dayNotes/{dayNoteId} {
      // Read: author for personal, household members for household notes
      allow read: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.householdId != null && resource.data.householdId != '' && isHouseholdMember(resource.data.householdId))
      );
      
      // Create: must be the author
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid;
      
      // Update: author or household member
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdMember(resource.data.householdId))
      );
      
      // Delete: author or household admin
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdAdmin(resource.data.householdId))
      );
    }
    
    // ========================================
    // MESSAGES COLLECTIONS
    // ========================================
    match /shiftMessages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }
    
    match /dayMessages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }
    
    // ========================================
    // INVITATIONS COLLECTION
    // ========================================
    match /invitations/{invitationId} {
      // Household admins can read all invitations for their household
      // Any authenticated user can read (needed to look up by invite code)
      allow read: if isAuthenticated();
      
      // Household admins can create invitations
      allow create: if isAuthenticated();
      
      // Any authenticated user can update (accept/decline)
      allow update: if isAuthenticated();
      
      // Admins can delete
      allow delete: if isAuthenticated();
    }
    
    // ========================================
    // NOTIFICATIONS COLLECTION
    // ========================================
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Authenticated users can create notifications (for other users)
      allow create: if isAuthenticated();
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // CUSTOM PATTERNS COLLECTION
    // ========================================
    match /customPatterns/{patternId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // AUDIT LOGS COLLECTION
    // ========================================
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // ========================================
    // SECURITY EVENTS COLLECTION
    // ========================================
    match /securityEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // ========================================
    // SUBSCRIPTIONS COLLECTION
    // ========================================
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // CATCH-ALL: Deny everything else
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
